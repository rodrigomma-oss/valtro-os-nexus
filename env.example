# Variáveis de ambiente — Valtro OS
# Copie este arquivo como .env na raiz e preencha com os valores reais.
# Não comite valores reais de segredos.

# --- Supabase (públicas, usadas no frontend) ---
# VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SEU_TOKEN
# VITE_SUPABASE_PROJECT_ID=SEU_PROJECT_ID

# --- Supabase (servidor / SSR) ---
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_SEU_TOKEN
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_SEU_TOKEN

# --- Criptografia da API interna (hex de 32 bytes = 64 caracteres) ---
# API_MASTER_ENCRYPTION_KEY=
# API_MASTER_KEY_VERSION=v1

# --- Google Calendar (OAuth) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALENDAR_TOKEN_KEY=
# GOOGLE_CALENDAR_CRON_SECRET=

# --- Testes E2E (opcional) ---
# E2E_TEST_EMAIL=
# E2E_TEST_PASSWORD=
# TEST_LEAD_ID=
# PLAYWRIGHT_BASE_URL=http://localhost:8080
